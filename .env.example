# Copy to .env and set real values. .env is gitignored.
# Used by docker-compose.yml and by tuition-api (spring.config.import).
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tuition
DB_USERNAME=tuition
DB_PASSWORD=change-me

# JWT signing secret for tuition-api (HS256). At least 32 bytes.
# Generate one with: openssl rand -base64 48  (the API refuses to start if it is empty or too short)
JWT_SECRET=
