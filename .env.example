# Copy to .env and set real values. .env is gitignored.
# Used by docker-compose.yml and by tuition-api (spring.config.import).

# DB_HOST/DB_PORT are for running the API on the host (./mvnw spring-boot:run).
# Inside docker compose the API container overrides them (postgres:5432).
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tuition
DB_USERNAME=tuition
DB_PASSWORD=change-me

# JWT signing secret for tuition-api and the Kong gateway (HS256). At least 32 bytes,
# no double quotes or backslashes.
# Generate one with: openssl rand -base64 48  (the API and Kong refuse to start if it is empty or too short)
JWT_SECRET=

# Optional: host port of the Kong gateway (default 8090).
# KONG_PROXY_PORT=8090

# Optional: host port of the MCP server (default 8091). MCP endpoint: http://localhost:8091/mcp
# MCP_PORT=8091

# --- AI agent (agent/, runs on the host: cd agent && uv run tuition-agent) ---
# Your own OpenAI API key. Never commit it.
OPENAI_API_KEY=
# Cheapest current tool-calling model (see README "LLM cost"). Any Chat Completions model with tools works.
OPENAI_MODEL=gpt-6-luna
# gpt-6-luna needs "none" for function calling in Chat Completions. Leave empty to not send the parameter.
OPENAI_REASONING_EFFORT=none
# Optional: where the agent sends REST calls (Kong) and MCP calls.
# AGENT_GATEWAY_URL=http://localhost:8090
# AGENT_MCP_URL=http://localhost:8091/mcp
# Azure deployment (the first request may take ~30 s while the API wakes up):
# AGENT_GATEWAY_URL=https://tuition-kong.happymoss-ea707327.polandcentral.azurecontainerapps.io
# AGENT_MCP_URL=https://tuition-mcp.happymoss-ea707327.polandcentral.azurecontainerapps.io/mcp
